name: Permanent Windows RDP Server

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    timeout-minutes: 360

    steps:
      - name: 1. Checkout Repository
        uses: actions/checkout@v4

      - name: 2. Create Admin Account & Workspace Folder
        env:
          RDP_PASSWORD: ${{ secrets.RDP_PASSWORD }}
        run: |
          $Password = ConvertTo-SecureString $env:RDP_PASSWORD -AsPlainText -Force
          New-LocalUser -Name "behrad" -Password $Password -PasswordNeverExpires -ErrorAction SilentlyContinue
          Add-LocalGroupMember -Group "Administrators" -Member "behrad" -ErrorAction SilentlyContinue
          net user runneradmin $env:RDP_PASSWORD
          
          New-Item -ItemType Directory -Force -Path "C:\Users\behrad\workspace"

      - name: 3. Restore Persistent Workspace
        uses: actions/cache@v4
        with:
          path: C:\Users\behrad\workspace
          key: cynet-rdp-workspace-v1
          restore-keys: |
            cynet-rdp-workspace-v1
            cynet-rdp-workspace-

      - name: 4. Enable Remote Desktop & Firewall
        run: |
          Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -name "fDenyTSConnections" -Value 0
          Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
          Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp' -name "UserAuthentication" -Value 0

      - name: 5. Set Dark Theme + Persian Keyboard
        run: |
          # فعال کردن تم دارک
          reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize" /v AppsUseLightTheme /t REG_DWORD /d 0 /f
          reg add "HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize" /v SystemUsesLightTheme /t REG_DWORD /d 0 /f
          reg add "HKU\.DEFAULT\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize" /v AppsUseLightTheme /t REG_DWORD /d 0 /f
          reg add "HKU\.DEFAULT\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize" /v SystemUsesLightTheme /t REG_DWORD /d 0 /f

          # اضافه کردن کیبورد فارسی
          $LanguageList = Get-WinUserLanguageList
          $LanguageList.Add("fa-IR")
          Set-WinUserLanguageList $LanguageList -Force

          # تنظیم جابه‌جایی زبان با Shift+Alt
          Set-WinLanguageBarOption -UseLegacySwitchMode
          Set-ItemProperty -Path "HKCU:\Keyboard Layout\Toggle" -Name "Hotkey" -Value "1" -Type String -Force
          Set-ItemProperty -Path "HKCU:\Keyboard Layout\Toggle" -Name "Language Hotkey" -Value "1" -Type String -Force
          Set-ItemProperty -Path "HKCU:\Keyboard Layout\Toggle" -Name "Layout Hotkey" -Value "2" -Type String -Force

      - name: 6. Install & Connect Tailscale VPN
        env:
          TAILSCALE_AUTHKEY: ${{ secrets.TAILSCALE_AUTHKEY }}
        run: |
          Invoke-WebRequest "https://pkgs.tailscale.com/stable/tailscale-setup-latest-amd64.msi" -OutFile "C:\tailscale.msi"
          Start-Process msiexec -ArgumentList "/i C:\tailscale.msi /quiet /norestart" -Wait
          
          Start-Sleep -Seconds 5
          & "C:\Program Files\Tailscale\tailscale.exe" up --authkey="$Env:TAILSCALE_AUTHKEY" --hostname="github-rdp-server"
          
          Start-Sleep -Seconds 8
          
          $ts_ip = & "C:\Program Files\Tailscale\tailscale.exe" ip -4
          
          Write-Host ""
          Write-Host "==================================================" -ForegroundColor Green
          Write-Host "  >>> RDP SERVER IS READY! <<<" -ForegroundColor Cyan
          Write-Host "  Tailscale IP    : $ts_ip" -ForegroundColor Yellow
          Write-Host "  Username        : behrad" -ForegroundColor Yellow
          Write-Host "  Password        : (from secrets)" -ForegroundColor Yellow
          Write-Host "  Persistent Path : C:\Users\behrad\workspace" -ForegroundColor Cyan
          Write-Host "  >> Open mstsc and connect to: $ts_ip" -ForegroundColor Magenta
          Write-Host "==================================================" -ForegroundColor Green

      - name: 7. Show Current Workspace Files
        run: |
          Write-Host "----- محتویات فعلی پوشه workspace -----" -ForegroundColor Cyan
          Get-ChildItem -Path "C:\Users\behrad\workspace" -Recurse -ErrorAction SilentlyContinue | Select-Object FullName, Length, LastWriteTime
          Write-Host "----------------------------------------"

      - name: 8. Keep Server Alive (5 Hours 55 Minutes)
        run: |
          for ($i = 1; $i -le 355; $i++) {
            Start-Sleep -Seconds 60
            Write-Host "[$i/355] Windows RDP Server active..."
          }

      - name: 9. Save Workspace to Cloud
        uses: actions/cache@v4
        if: always()
        with:
          path: C:\Users\behrad\workspace
          key: cynet-rdp-workspace-v1
